# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=py3-haltia-kit
pkgver=2.3.0
pkgrel=0
pkgdesc="What the Haltia programs share: questions, settings, sound, photos, secrets (GTK 3)"
url="https://github.com/haltia-de/kit"
arch="noarch"
# The name before ADR 0004: apk upgrade carries py3-b8k-compat over to this.
provides="py3-b8k-compat=$pkgver-r$pkgrel"
replaces="py3-b8k-compat"
license="GPL-2.0-only"
# Pictures: py3-pillow. Sound and media details: py3-mpv (mpv-libs),
# py3-mutagen, ffmpeg. The vault: libsecret (its typelib is in the package
# itself). The optional camera: gstreamer with gst-plugins-base and gst-plugins-good
# (v4l2src); libcamerasrc (libcamera-gstreamer) comes with the device.
depends="python3 py3-gobject3 gtk+3.0 libsecret py3-pillow py3-mpv py3-mutagen ffmpeg"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="gdk-pixbuf"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/haltia-de/kit/archive/v$pkgver.tar.gz"
builddir="$srcdir/kit-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 tests/test_compat.py
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

pyc() {
	default_pyc
	provides="py3-b8k-compat-pyc=$pkgver-r$pkgrel"
	replaces="py3-b8k-compat-pyc"
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"

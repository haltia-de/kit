# Maintainer: Mikhail Nevskiy <rensomail@gmail.com>
pkgname=py3-b8k-compat
pkgver=1.1
pkgrel=0
pkgdesc="What the b8k programs share: questions, settings, sound, photos (GTK 3)"
url="https://github.com/trudenboy/b8k-compat"
arch="noarch"
license="GPL-2.0-only"
# Sound and media details: py3-mpv (mpv-libs), py3-mutagen, ffmpeg.
depends="python3 py3-gobject3 gtk+3.0 py3-mpv py3-mutagen ffmpeg"
makedepends="py3-gpep517 py3-setuptools py3-wheel"
checkdepends="gdk-pixbuf"
subpackages="$pkgname-pyc"
source="$pkgname-$pkgver.tar.gz::https://github.com/trudenboy/b8k-compat/archive/v$pkgver.tar.gz"
builddir="$srcdir/b8k-compat-$pkgver"

build() {
	gpep517 build-wheel --wheel-dir .dist --output-fd 3 3>&1 >&2
}

check() {
	python3 tests/test_compat.py
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl
}

# `abuild checksum` fills this in for a release.
sha512sums="SKIP"
